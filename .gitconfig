[user]
	name = Ehsan Ghorbani
	email = t1m3runn3r2359@protonmail.com
	signingkey = /home/t1m3runn3r2359/.ssh/id_ed25519
[diff]
	tool = difft
[alias]
    dl = -c diff.external=difft log -p --ext-diff

    ds = -c diff.external=difft show --ext-diff

    dft = -c diff.external=difft diff
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = /home/t1m3runn3r2359/.ssh/allowed_signers

[diff "docx"]
    textconv = pandoc --to=plain

