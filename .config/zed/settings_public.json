// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "diff_view_style": "unified",
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "model": "opus[1m]",
        "agent": "default",
        "mode": "auto"
      },
      "type": "registry"
    },
    "cline": {
      "type": "registry",
    },
    "opencode": {
      "default_config_options": {
        "model": "anthropic/claude-opus-4-8"
      },
      "type": "registry",
    },
    "kimi": {
      "type": "registry",
    },
    "kilo": {
      "type": "registry",
    },
  },
  "context_servers": {
    "mcp-server-gitlab": {
      "enabled": true,
      "remote": false,
      "settings": {
        "gitlab_personal_access_token": "",
        "gitlab_api_url": "https://gitlab.neshan.org/api/v4",
      },
    },
    "mcp-server-figma": {
      "enabled": true,
      "remote": false,
      "settings": {
        "figma_api_key": "",
      },
    },
    "postgres-context-server": {
      "enabled": false,
      "remote": false,
      "settings": {},
    },
  },
  "auto_update": true,
  "diagnostics": {
    "inline": {
      "enabled": false,
    },
  },
  "languages": {
    "Java": {
      "formatter": {
        "external": {
          "command": "google-java-format",
          "arguments": ["-"],
        },
      },
    },
    "JavaScript": {
      "formatter": [
        "prettier",
        {
          "code_action": "source.fixAll.eslint",
        },
      ],
    },
  },
  "diagnostics_max_severity": "error",
  "edit_predictions": {
    "mode": "subtle",
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": true,
    },
  },
  "format_on_save": "off",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "agent": {
    "show_turn_stats": true,
    "single_file_review": true,
    "sidebar_side": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "dock": "left",
    "profiles": {
      "write": {
        "name": "Write",
